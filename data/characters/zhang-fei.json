  "romanceBio": [
    {
      "chapter": "第一回",
      "eventName": "桃園結義",
      "content": {
        "paragraphs": [
          {
            "text": "小說安排劉備、關羽、張飛在張飛莊後桃園祭告天地，結為異姓兄弟，依年齡以劉備為兄、關羽次之、張飛為弟。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第一回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "此為小說情節，正史無正式結拜儀式。《三國志》只能證明劉備與二人恩若兄弟，以及張飛因關羽年長而以兄長之禮事奉他。",
            "citations": [
              {
                "sourceId": "sgz-guanyu-main",
                "locator": "卷三十六・關羽傳開篇"
              },
              {
                "sourceId": "sgz-zhangfei-main",
                "locator": "卷三十六・張飛傳開篇"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第二回",
      "eventName": "怒鞭督郵",
      "content": {
        "paragraphs": [
          {
            "text": "小說寫督郵刁難劉備、索取賄賂，張飛得知後將督郵綁在縣衙前痛打，劉備趕來制止，三人隨後棄官離去。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第二回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "正史與演義的人物分配恰好相反：《三國志・先主傳》正文記載劉備本人闖入驛舍綁住督郵、杖打二百，完全沒有張飛參與；《三國演義》才把動手者改寫為張飛。",
            "citations": [
              {
                "sourceId": "sgz-liubei-main",
                "locator": "卷三十二・安喜尉鞭督郵段"
              }
            ]
          }
        ],
        "originalTexts": [
          {
            "text": "督郵以公事到縣，先主求謁，不通，直入縛督郵，杖二百，解綬繫其頸著馬枊，棄官亡命。",
            "sourceId": "sgz-liubei-main",
            "locator": "卷三十二・先主傳"
          }
        ]
      }
    },
    {
      "chapter": "第五回",
      "eventName": "三英戰呂布",
      "content": {
        "paragraphs": [
          {
            "text": "小說在虎牢關之戰安排張飛先與呂布單挑，關羽、劉備陸續加入，三人合戰逼退呂布，成為桃園兄弟共同作戰的代表場面。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第五回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "此為小說情節，正史沒有劉備、關羽、張飛在虎牢關合戰呂布的記載。",
            "citations": [
              {
                "sourceId": "sgz-zhangfei-main",
                "note": "張飛本傳無此事"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第十四回",
      "eventName": "酒後失徐州",
      "content": {
        "paragraphs": [
          {
            "text": "小說寫劉備留張飛守徐州並要求禁酒，張飛卻醉酒鞭打曹豹，曹豹遂引呂布夜襲下邳，張飛敗走。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第十四回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "《先主傳》正文只記曹豹反叛、暗中迎接呂布；裴松之注引《英雄記》則記張飛留守下邳、欲殺曹豹，曹豹固守並招引呂布。史料沒有張飛因醉酒誤事、劉備下達禁酒命令或曹豹因受鞭而反的完整小說情節。",
            "citations": [
              {
                "sourceId": "sgz-liubei-main",
                "locator": "卷三十二・建安元年徐州失守"
              },
              {
                "sourceId": "yingxiongji-xuzhou",
                "locator": "《先主傳》裴注引《英雄記》"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第四十二回",
      "eventName": "長坂橋一聲退曹軍",
      "content": {
        "paragraphs": [
          {
            "text": "小說擴寫張飛單騎立於長坂橋頭、連聲喝問誰敢決死，使夏侯傑驚落馬下、曹操大軍回身潰退；張飛其後拆斷橋梁撤離。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第四十二回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "事件核心有正史依據：張飛確率二十騎據水斷橋、橫矛喝敵，使追兵無人敢近。但夏侯傑被喝死、曹操全軍因一聲大潰等戲劇效果為小說增飾。",
            "citations": [
              {
                "sourceId": "sgz-zhangfei-main",
                "locator": "卷三十六・當陽長坂"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第六十三回",
      "eventName": "義釋嚴顏",
      "content": {
        "paragraphs": [
          {
            "text": "小說寫張飛以計攻破巴郡、生擒嚴顏，因敬佩嚴顏寧死不降的氣節而親自解縛、延為賓客，之後藉嚴顏協助一路招降沿途關隘。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第六十三回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "義釋嚴顏本身是正史記載，不是小說虛構；《三國演義》主要增寫張飛奪城用計及嚴顏協助招降沿途守軍等細節。",
            "citations": [
              {
                "sourceId": "sgz-zhangfei-main",
                "locator": "卷三十六・江州破嚴顏段"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第七十回",
      "eventName": "智取瓦口隘",
      "content": {
        "paragraphs": [
          {
            "text": "小說將巴西之戰改寫為張飛以飲酒示敵、另走小路突襲張郃，最終奪取瓦口隘，突出其粗中有細。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第七十回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "正史確載張飛利用山道狹窄、張郃軍前後不能相救而大破敵軍，但沒有飲酒詐敵等具體計謀；這些是小說為凸顯張飛智略所作的戲劇化重構。",
            "citations": [
              {
                "sourceId": "sgz-zhangfei-main",
                "locator": "卷三十六・巴西之戰"
              }
            ]
          }
        ]
      }
    },
    {
      "chapter": "第八十一回",
      "eventName": "急兄仇，遇害於閬中",
      "content": {
        "paragraphs": [
          {
            "text": "小說寫張飛急於替關羽報仇，命部將范疆、張達在三日內製備白旗白甲；二人因無法完成而遭痛打，害怕再受重罰，遂趁張飛醉臥時將他殺害，帶首級投奔東吳。",
            "citations": [
              {
                "sourceId": "sanguo-yanyi",
                "locator": "第八十一回"
              }
            ]
          }
        ]
      },
      "historicalDifference": {
        "paragraphs": [
          {
            "text": "正史只記張飛準備率萬人由閬中赴江州會師，臨行前被帳下將張達、范彊殺害；白旗白甲期限、二人受鞭、張飛醉臥等直接導火線均不見史書。陳壽確實把張飛長期刑殺過差、不恤部下列為遇害背景，但沒有稱他『大意』。",
            "citations": [
              {
                "sourceId": "sgz-zhangfei-main",
                "locator": "卷三十六・張飛傳末"
              }
            ]
          }
        ]
